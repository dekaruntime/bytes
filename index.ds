// Uint8Array-backed bytes. Bind results with `let`, not `const`:
// Deka freezes const values, and JS cannot freeze typed arrays.
//
// rfd#39 / deka#913: host ops are summoned. Encoder/decoder/slice/concat/from
// and the hex/base64 encoders are `total`. `from_hex` / `from_base64` use the
// Exception channel for invalid input (rfd#62). Abort helpers that existed
// only to turn `throw` into `unsafe` Err are gone — totals do not fail, and
// decode failures raise.
summon { total encode_utf8(value: string) bytes, total decode_utf8(value: bytes) string, total slice_from(value: bytes, start: number) bytes, total concat_bytes(a: bytes, b: bytes) bytes, total from_numbers(values: Array<number>) bytes, total encode_hex(value: bytes) string, from_hex_bytes(value: string) Exception<bytes, JsError>, total encode_base64(value: bytes) string, from_base64_bytes(value: string) Exception<bytes, JsError> } from "./shim.mjs"

export fn from_string(value: string) bytes {
  return encode_utf8(value)
}

export fn to_string_lossy(value: bytes) string {
  return decode_utf8(value)
}

export fn to_string(value: bytes) string {
  return to_string_lossy(value)
}

export fn len(value: bytes) number {
  return value.length
}

export fn get(value: bytes, index: number) number {
  return index >= 0 && index < value.length ? value[index] : -1
}

export fn slice(value: bytes, start: number) bytes {
  return slice_from(value, start)
}

export fn concat(a: bytes, b: bytes) bytes {
  return concat_bytes(a, b)
}

export fn from_array(values: Array<number>) bytes {
  return from_numbers(values)
}

export fn to_hex(value: bytes) string {
  return encode_hex(value)
}

export fn from_hex(value: string) Exception<bytes, JsError> {
  return from_hex_bytes(value)
}

export fn to_base64(value: bytes) string {
  return encode_base64(value)
}

export fn from_base64(value: string) Exception<bytes, JsError> {
  return from_base64_bytes(value)
}
